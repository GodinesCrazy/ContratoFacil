{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://TU-BACKEND-RAILWAY.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://TU-BACKEND-RAILWAY.up.railway.app/health"
    },
    {
      "source": "/ready",
      "destination": "https://TU-BACKEND-RAILWAY.up.railway.app/ready"
    }
  ]
}
